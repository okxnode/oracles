# ============================================================================
#  oracles 生产环境配置
#
#  部署到 /etc/oracles/oracles.env，权限必须是 600，属主是运行 Bot 的用户。
#      sudo install -m 600 -o oracles -g oracles \
#           deploy/oracles.env.example /etc/oracles/oracles.env
#
#  ⚠️ 这个文件**绝不能**进版本库。它不在仓库目录里，所以天然安全。
# ============================================================================

# ---------- 必填 ----------

TELEGRAM_BOT_TOKEN=在这里填BotFather给的token

# 允许操作 Bot 的 Telegram 用户 ID，逗号分隔。
# 留空 = 不响应任何人（安全默认值）。
# 拿自己的 ID：给 @userinfobot 发一条消息
TELEGRAM_ALLOWED_USER_IDS=

# ---------- 配置目录 ----------

# 账号清单和私钥放这里（仓库之外）
ORACLES_HOME=/etc/oracles

# ---------- 写操作开关（双保险）----------

# false = 所有写操作强制 DRY-RUN，只出计划不执行
# 首次部署强烈建议先用 false 跑几天，确认计划内容都对再打开
ORACLES_WRITE_ENABLED=false

# 与上一条是「与」关系，两个都为 true 才允许销毁实例/删除存储桶。
# 平时保持 false，需要做危险操作时临时打开，做完立刻关掉。
ORACLES_ALLOW_DESTRUCTIVE=false

# ---------- 可选项 ----------

ORACLES_LOG_LEVEL=INFO

# 账号条目里没写 key_file 时用这个
OCI_API_KEY_FILE=/etc/oracles/keys/oci_api_key.pem

ORACLES_TIMEOUT=120
ORACLES_MAX_CONCURRENCY=4

# 开机时自动注入的 SSH 公钥。不设的话会去读 ~/.ssh/id_ed25519.pub。
# ⚠️ 只注入公钥。绝不把密码写进 user_data —— 那是 base64 不是加密，
#    等于把密码公开，而且每次开新机都会重放一遍。
# ORACLES_SSH_PUBLIC_KEY=ssh-ed25519 AAAA... you@host

# 救援控制台（「🚑 救援」按钮）用的 RSA 公钥。
#
# 不设的话：每次点救援都现场生成一对临时 RSA，并把**私钥**发到 Telegram 里
#           让你存成文件 —— 一次性、用完即弃。
# 设了的话：不发私钥（私钥本来就在你手里），只把公钥交给 OCI。
#
# ⚠️ **必须是 RSA**（ssh-rsa 开头）。OCI 的 create_instance_console_connection
#    只收 RSA —— 实测 ed25519 会被服务端拒绝：
#        InvalidParameter: Invalid ssh public key type "ssh-ed25519"
#    所以不能直接拿上面那把开机用的 ed25519 公钥来充数。
# ORACLES_CONSOLE_PUBLIC_KEY=ssh-rsa AAAA... you@host
