# ============================================================
#  oracles 环境变量示例
#  用法：cp .env.example .env  然后填入真实值（.env 已被 .gitignore 忽略）
#
#  ⚠️ 生产环境建议不要用 .env，而是把变量写进
#     /etc/oracles/oracles.env（chmod 600），由 systemd 的
#     EnvironmentFile= 加载。见 docs/04-部署到VPS.md
# ============================================================

# ---------- 必填 ----------

# Telegram Bot Token（@BotFather 申请）
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenReplaceMeWithRealOne

# 允许操作 Bot 的 Telegram 用户 ID，逗号分隔。
# 留空 = 任何人发消息都不响应（安全默认值，不会自动放开）。
# 获取自己的 ID：给 @userinfobot 发一条消息
TELEGRAM_ALLOWED_USER_IDS=100000001,100000002

# ---------- 配置目录 ----------

# 账号清单与私钥的存放位置。默认 ~/.oracles
# 刻意放在仓库之外，从根上杜绝「密钥随代码一起 push」
ORACLES_HOME=/etc/oracles

# ---------- 写操作总开关 ----------

# true  = 允许真正执行写操作（创建/删除/重启）
# false = 所有写操作强制走 DRY-RUN，只打印将要做什么（推荐首次部署用这个）
ORACLES_WRITE_ENABLED=false

# 是否允许「销毁实例 / 删除存储桶」这类不可逆操作。
# 与 ORACLES_WRITE_ENABLED 是「与」关系，两个都为 true 才放行。
ORACLES_ALLOW_DESTRUCTIVE=false

# ---------- 可选项 ----------

# 日志级别：DEBUG / INFO / WARNING / ERROR
ORACLES_LOG_LEVEL=INFO

# 全局 OCI API 私钥路径。账号条目里没写 key_file 时用这个。
# OCI_API_KEY_FILE=/etc/oracles/keys/oci_api_key.pem

# 单次操作超时（秒）
ORACLES_TIMEOUT=120

# 同时查询的最大账号数（避免把 OCI API 打限流）
ORACLES_MAX_CONCURRENCY=4

# 救援控制台用的 RSA 公钥（可选）。
# 不设 = 每次点「🚑 救援」现场生成一对临时 RSA，私钥发到 Telegram 里让你保存；
# 设了 = 不发私钥，私钥在你自己手里。**必须是 ssh-rsa** ——
# OCI 的 create_instance_console_connection 不收 ed25519。
# ORACLES_CONSOLE_PUBLIC_KEY=ssh-rsa AAAA... you@host
